  elseif($action==='init_vault'){$kdf=SecretGuard::initializeVault($_POST['master_password']??'',$_POST['master_password_confirm']??'');$message='Encrypted vault initialized and unlocked using '.$kdf.'. The master key is held only in /run (RAM) for this boot.';}
  elseif($action==='unlock_vault'){$result=SecretGuard::unlockVault($_POST['master_password']??'',$settings['SECRET_DIR'],$_SERVER['REMOTE_ADDR']??'unknown');$message='Vault unlocked. Restored '.$result['env_count'].' runtime env file(s). Resumed '.count($result['resumed']).' protected container(s).'.(!empty($result['errors'])?' Some containers need attention: '.implode('; ',$result['errors']):'');}
  elseif($action==='lock_vault'){$result=SecretGuard::lockVault($settings['SECRET_DIR']);$message='Vault locked. Stopped '.count($result['stopped']).' protected container(s), then removed runtime plaintext env files and the derived key from RAM.';}
  elseif($action==='change_master_password'){$count=SecretGuard::changeMasterPassword($_POST['old_master_password']??'',$_POST['new_master_password']??'',$_POST['new_master_password_confirm']??'',$settings['SECRET_DIR'],$_SERVER['REMOTE_ADDR']??'unknown');$message='Vault master password changed safely. Re-encrypted and verified '.$count.' vault file(s). The new derived key is active for this boot.';}
  elseif($action==='clear_unlock_lockout'){SecretGuard::clearUnlockLockout();$message='Vault unlock cooldown cleared.';}
  elseif($action==='reset_vault'){SecretGuard::resetVault($settings['SECRET_DIR']);$message='Vault configuration reset. You can now initialize a new Vault with a new master password at any time.';}
  elseif($action==='migrate'){$file=base64_decode($_POST['template']??'',true);$targets=isset($_POST['targets'])&&is_array($_POST['targets'])?$_POST['targets']:[];$result=SecretGuard::migrate($file,$targets,$settings['SECRET_DIR'],$settings['STORAGE_MODE']);$message='Protected '.count($result['migrated']).' variable(s) for '.$result['container'].'. '.$result['recreate']['message'];}
  elseif($action==='rollback'){$file=base64_decode($_POST['template']??'',true);$result=SecretGuard::rollback($file,$settings['SECRET_DIR']);$message='Rolled back SecretGuard protection for '.$result['container'].'. Restored '.count($result['restored']).' variable(s) from the SecretGuard env metadata, removed the SecretGuard env/vault file, and recreated the container. '.$result['recreate']['message'];}
 }catch(Throwable $e){$error=$e->getMessage();}
}
$rows=SecretGuard::scan();$status=SecretGuard::storageStatus($settings['SECRET_DIR']);$storageChoices=SecretGuard::storageChoices();$recommendedDir=SecretGuard::recommendedSecretDir();$crypto=SecretGuard::cryptoStatus();$overview=SecretGuard::containerOverview($settings['SECRET_DIR']);$vaultReset=SecretGuard::vaultResetStatus($settings['SECRET_DIR']);$groups=[];foreach($rows as $r)$groups[$r['container']][]=$r;
