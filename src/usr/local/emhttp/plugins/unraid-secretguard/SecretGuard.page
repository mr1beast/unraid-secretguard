<?php
require_once '/usr/local/emhttp/plugins/unraid-secretguard/include/SecretGuard.php';
$settings=SecretGuard::settings();$message='';$error='';
if($_SERVER['REQUEST_METHOD']==='POST'){
 try{$action=$_POST['action']??'';
  if($action==='save_settings'){SecretGuard::saveSettings($_POST['secret_dir']??'',$_POST['storage_mode']??'plain',isset($_POST['auto_watch'])?'yes':'no');$settings=SecretGuard::settings();@shell_exec('/usr/local/emhttp/plugins/unraid-secretguard/scripts/restart-watcher.sh >/dev/null 2>&1 &');$message='Settings saved.';}
  elseif($action==='init_vault'){$kdf=SecretGuard::initializeVault($_POST['master_password']??'',$_POST['master_password_confirm']??'');$message='Encrypted vault initialized and unlocked using '.$kdf.'. The master key is held only in /run (RAM) for this boot.';}
  elseif($action==='unlock_vault'){$count=SecretGuard::unlockVault($_POST['master_password']??'',$settings['SECRET_DIR']);$message='Vault unlocked. Restored '.$count.' runtime env file(s) into /run.';}
  elseif($action==='lock_vault'){SecretGuard::lockVault();$message='Vault locked and runtime plaintext env files removed. Running containers may still retain environment values in memory/metadata.';}
  elseif($action==='migrate'){$file=base64_decode($_POST['template']??'',true);$targets=isset($_POST['targets'])&&is_array($_POST['targets'])?$_POST['targets']:[];$result=SecretGuard::migrate($file,$targets,$settings['SECRET_DIR'],$settings['STORAGE_MODE']);$message='Protected '.count($result['migrated']).' variable(s) for '.$result['container'].'. '.$result['recreate']['message'];}
  elseif($action==='rollback'){$file=base64_decode($_POST['template']??'',true);$result=SecretGuard::rollback($file,$settings['SECRET_DIR']);$message='Rolled back SecretGuard protection for '.$result['container'].'. Restored '.count($result['restored']).' variable(s) from the SecretGuard env metadata, removed the SecretGuard env/vault file, and recreated the container. '.$result['recreate']['message'];}
 }catch(Throwable $e){$error=$e->getMessage();}
}
$rows=SecretGuard::scan();$status=SecretGuard::storageStatus($settings['SECRET_DIR']);$crypto=SecretGuard::cryptoStatus();$overview=SecretGuard::containerOverview($settings['SECRET_DIR']);$groups=[];foreach($rows as $r)$groups[$r['container']][]=$r;
?>
<style>
.sg-card{background:#fff0;border:1px solid #6665;border-radius:6px;padding:16px;margin:14px 0}.sg-high{color:#d9534f;font-weight:700}.sg-medium{color:#f0ad4e;font-weight:700}.sg-low{color:#6c757d}.sg-ignore{color:#5cb85c}.sg-table{width:100%;border-collapse:collapse}.sg-table th,.sg-table td{padding:7px 8px;border-bottom:1px solid #7773;text-align:left}.sg-audit-table{table-layout:fixed}.sg-audit-table th:nth-child(1),.sg-audit-table td:nth-child(1){width:7%}.sg-audit-table th:nth-child(2),.sg-audit-table td:nth-child(2){width:33%}.sg-audit-table th:nth-child(3),.sg-audit-table td:nth-child(3){width:9%}.sg-audit-table th:nth-child(4),.sg-audit-table td:nth-child(4){width:13%}.sg-audit-table th:nth-child(5),.sg-audit-table td:nth-child(5){width:38%}.sg-audit-table td{overflow-wrap:anywhere}.sg-note{opacity:.85}.sg-ok{color:#5cb85c}.sg-warn{color:#f0ad4e}.sg-error{color:#d9534f}.sg-actions{margin-top:12px}.sg-container{font-size:1.1em;font-weight:700;margin-bottom:8px}.sg-danger{border-left:4px solid #d9534f}.sg-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px}.sg-grid>div{padding:10px;border:1px solid #7773;border-radius:4px}.sg-badge{display:inline-block;padding:3px 8px;border-radius:999px;font-size:.85em;font-weight:700}.sg-badge-ok{background:#2e7d3230;color:#66bb6a}.sg-badge-off{background:#7772;color:#aaa}.sg-overview td{vertical-align:middle}.sg-inline{display:inline-block;margin:0 6px 0 0}
